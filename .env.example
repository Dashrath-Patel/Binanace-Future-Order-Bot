# Binance API Configuration
# Copy this to .env and fill in your actual API credentials

# Binance API Keys (Required)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Use testnet for safe testing (Recommended)
# Set to 'false' for production trading
BINANCE_TESTNET=true

# Testnet API keys can be obtained from:
# https://testnet.binancefuture.com/

# Production API keys can be obtained from:
# https://www.binance.com/en/my/settings/api-management
